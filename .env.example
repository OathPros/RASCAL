# Optional private catalogue location. Leave unset to use data/catalogue.csv.
CATALOGUE_PATH=

# Optional Cohere second-stage reranking. Local deterministic ranking always runs first.
COHERE_ENABLED=false
COHERE_API_KEY=
COHERE_MODEL=rerank-v4.0-fast
COHERE_TOP_K=25
COHERE_TIMEOUT_SECONDS=3

# Optional LLM intent clarification/query normalization layer.
# When disabled or misconfigured, RASCAL keeps using local ranking plus optional Cohere.
INTENT_REFINEMENT_ENABLED=false
INTENT_REFINEMENT_PROVIDER=anthropic
INTENT_REFINEMENT_TARGET_URL=
INTENT_REFINEMENT_API_KEY=
# If your institution calls the secret an API code instead of an API key, use this alias.
INTENT_REFINEMENT_API_CODE=
# Header used to send the key/code. Common values: x-api-key, api-key, Authorization.
INTENT_REFINEMENT_AUTH_HEADER=x-api-key
INTENT_REFINEMENT_MODEL=claude-haiku-4-5
INTENT_REFINEMENT_TIMEOUT_SECONDS=8
INTENT_REFINEMENT_MAX_TURNS=2
INTENT_REFINEMENT_MIN_CONFIDENCE=0.65
INTENT_REFINEMENT_DEBUG=false

# Backward-compatible aliases still supported by the code if you later switch back.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=
